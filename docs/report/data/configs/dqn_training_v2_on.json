      "hard_max_acceleration": 5.0,
      "clamp_position": false,
      "clamp_velocity": false,
      "clamp_acceleration": false,
      "pole_length": 0.18,
      "pole_mass": 0.118,
      "gravity": 9.8
    },
    "reward_version": "R1-v0",
    "reward": {
      "version": "R1-v0",
      "reference_dt": 0.01,
      "evaluation_state": "end of actual transition",
      "formula": "dt_actual/.01*h*q(x/.25)*q(v/2)*q(omega/2)*q(.1*u_applied/4)-5*terminated",
      "height_formula": "h=(1-cos(theta))/2",
      "factor_formula": "q(z)=1/(1+z^2)",
      "normalizations": {
        "position_m": 0.25,
        "velocity_m_per_s": 2.0,
        "angular_velocity_rad_per_s": 2.0,
        "acceleration_m_per_s2": 4.0
      },
      "weights": {
        "height": 1.0,
        "position": 1.0,
        "velocity": 1.0,
        "angular_velocity": 1.0,
        "acceleration": 0.1,
        "failure": 5.0
      },
      "running_reward_bounds": [
        0.0,
        1.0
      ],
      "survival_constant": 0.0,
      "duration_tolerance_seconds": 1e-12
    },
    "gamma": 0.9980019986673331,
    "timestep": 0.01,
    "horizon": 10.0,
    "integrator": {
      "type": "RungeKutta3Integrator",
      "target_accuracy": 1e-06,
      "maximum_step_size": 0.01,
      "fixed_step_mode": false
    },
    "observation": "[x/.25,v/2,sin(theta),cos(theta),omega/sqrt(9.8/.18)]",
    "observation_dtype": "float32",
    "action": {
      "space": "Discrete(9)",
      "grid": [
        -4.0,
        -3.0,
        -2.0,
        -1.0,
        0.0,
        1.0,
        2.0,
        3.0,
        4.0
      ],
      "replay": "integer request index",
      "mapping": "u_requested=grid[index]; float64 normalized adapter before common physical filter",
      "evaluation": "deterministic argmax index; identical adapter",
      "filtered_dtype": "binary64; no requantization"
    },
    "reset": {
      "distribution": "lower-box-v1",
