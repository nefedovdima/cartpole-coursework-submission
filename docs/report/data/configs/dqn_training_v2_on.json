        "acceleration_limit": 4.0,
        "position_reserve": 1e-06,
        "velocity_reserve": 1e-06,
        "max_dt": 0.01,
        "min_dt": 1e-09,
        "dt_roundoff": 1e-12,
        "intervention_inset": 1e-08
